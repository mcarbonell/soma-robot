{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOMA_Robot_SensoryTelemetry",
  "description": "Standardized inbound payload generated by Thalamus and Hypothalamus for Neocortex reasoning.",
  "type": "object",
  "required": [
    "timestamp_utc",
    "wake_trigger",
    "homeostasis",
    "thalamus_percepts",
    "hippocampus_context"
  ],
  "properties": {
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "wake_trigger": {
      "type": "string",
      "enum": [
        "SCHEDULED_SAMPLE",
        "WAYPOINT_REACHED",
        "SENSORY_ANOMALY",
        "ENERGY_ALERT",
        "HUMAN_DISPATCH"
      ]
    },
    "homeostasis": {
      "type": "object",
      "required": [
        "battery_soc",
        "solar_input_watts",
        "net_power_watts",
        "max_core_temp_c",
        "stress_index"
      ],
      "properties": {
        "battery_soc": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "solar_input_watts": {
          "type": "number",
          "minimum": 0.0
        },
        "net_power_watts": {
          "type": "number"
        },
        "max_core_temp_c": {
          "type": "number"
        },
        "stress_index": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "thalamus_percepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "heading_deg", "clearance_m"],
        "properties": {
          "class": { "type": "string" },
          "heading_deg": { "type": "number" },
          "clearance_m": { "type": "number" }
        }
      }
    },
    "hippocampus_context": {
      "type": "object",
      "required": [
        "nearest_solar_haven",
        "distance_to_haven_m",
        "active_mission"
      ],
      "properties": {
        "nearest_solar_haven": { "type": "string" },
        "distance_to_haven_m": { "type": "number" },
        "active_mission": { "type": "string" },
        "relevant_retrieved_episodes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
