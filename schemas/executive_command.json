{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOMA_Robot_ExecutiveCommand",
  "description": "Standardized outbound payload generated by the Neocortex SLM to direct Cerebellar motion and Hippocampal memory.",
  "type": "object",
  "required": [
    "reasoning_trace",
    "executive_action",
    "next_wake_condition"
  ],
  "properties": {
    "reasoning_trace": {
      "type": "string",
      "description": "Brief, explicit chain of causal reasoning assessing energy margin and current objective."
    },
    "executive_action": {
      "type": "object",
      "required": ["command", "parameters"],
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "NAVIGATE_TRAJECTORY",
            "TRANSITION_TO_PASTURE",
            "ENTER_REM_CONSOLIDATION",
            "EMERGENCY_HALT",
            "MANIPULATE_OBJECT",
            "STANDBY_WAIT"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "memory_update": {
      "type": "object",
      "properties": {
        "annotate_waypoint": { "type": "string" },
        "log_failure_cause": { "type": "string" },
        "discard_temporary_node": { "type": "string" }
      }
    },
    "next_wake_condition": {
      "type": "string",
      "description": "Event trigger that should next wake the Neocortex from low-power sleep."
    }
  }
}
